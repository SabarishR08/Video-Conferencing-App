# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# JWT Secret Key
# Generate a random secret key for production
# Example: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# MongoDB Connection URI
# Local: mongodb://localhost:27017/meet-app
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/meet-app
MONGODB_URI=mongodb://localhost:27017/meet-app

# Server Port
PORT=6001

# Optional: Node Environment
NODE_ENV=development

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Replace placeholder values with your actual configuration
# 3. Never commit the .env file to version control
# 4. For production, use secure secret keys and connection strings
